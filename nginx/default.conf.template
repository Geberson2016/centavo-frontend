# Servidor da UI em produção/compose. ${BFF_URL} é trocado pelo envsubst na subida.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Mesmo papel do proxy do Vite em dev: a UI fala com o BFF na mesma origem, mantendo
    # o prefixo /bff no caminho repassado.
    location /bff/ {
        proxy_pass ${BFF_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Arquivos com hash no nome (gerados pelo Vite) podem ficar em cache para sempre.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # SPA: rota desconhecida cai no index.html e o React Router resolve. O index.html não
    # fica em cache, para um deploy novo chegar sem hard refresh.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
